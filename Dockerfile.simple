# Simple Dockerfile using pre-built dist folder
# Build the app first with: npm run build
# Then build the Docker image with: docker build -f Dockerfile.simple -t ux-republic-landing .

FROM nginx:alpine

# Copy pre-built assets
COPY dist /usr/share/nginx/html

# Copy custom nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
